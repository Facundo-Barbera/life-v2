# Copy to apps/pulso/web/.env.local (or the repo root) and fill in
# from the Supabase project. Never commit the real values.
# The service role key does not belong here, nor in any NEXT_PUBLIC_* variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3271

# The phone (apps/pulso/native/.env.local) uses the same project:
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
